<?xml version='1.0' encoding='utf-8' standalone='yes' ?>
<!-- Zain Kuwait (MCC 419 / MNC 02). Enables VoLTE: the stock LOS CarrierConfig
     has no entry for this PLMN, so carrier_config_applied was false and every
     VoLTE key defaulted off, leaving MMTel at emergency-only (no VOICE). Setting
     these live (cc set-value -p) unlocked the MMTel VOICE capability on-device. -->
<carrier_config_list>
    <carrier_config>
        <boolean name="carrier_volte_available_bool" value="true" />
        <boolean name="carrier_volte_provisioned_bool" value="true" />
        <boolean name="carrier_volte_provisioning_required_bool" value="false" />
        <boolean name="enhanced_4g_lte_on_by_default_bool" value="true" />
    </carrier_config>
</carrier_config_list>
